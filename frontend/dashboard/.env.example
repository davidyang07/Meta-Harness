# Meta-Harness dashboard environment. Copy to .env.local and fill in.
# Every variable is optional: with none set, the dashboard talks to a
# backend on http://localhost:8000 with no token and no login.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle when the
# dashboard is built or `next dev` starts, so restart after changing them.

# Where the FastAPI backend (`uv run meta-harness serve --port 8000`) listens.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Must equal the backend's META_HARNESS_API_TOKEN when that is set. Sent as
# `Authorization: Bearer <token>` on API calls; the SSE stream, which cannot
# send headers, uses a one-minute ticket the dashboard fetches with it, so
# the token never appears in a URL. Leave empty for a backend started
# without a token. Serving the dashboard from anything but port 3000 needs
# the backend's META_HARNESS_CORS_ORIGINS to name that origin.
#
# This is visible to anyone who can load the dashboard: it keeps other
# machines on the network off the backend, it is not a user login.
NEXT_PUBLIC_META_HARNESS_API_TOKEN=

# Optional Auth0 login in front of every dashboard page. Enabled only when
# AUTH0_DOMAIN, AUTH0_CLIENT_ID, AUTH0_SECRET and one of
# AUTH0_CLIENT_SECRET / AUTH0_CLIENT_ASSERTION_SIGNING_KEY are all set;
# otherwise the dashboard is open and shows no Login/Logout links.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32 random bytes, hex encoded: `openssl rand -hex 32`
AUTH0_SECRET=
# The URL the dashboard is served from; Auth0 redirects back here.
APP_BASE_URL=http://localhost:3000
