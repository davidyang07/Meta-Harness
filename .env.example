# Meta-Harness environment variables. Copy to .env and fill in.

# Anthropic API key — required for inner-loop LLM calls (BUILD_ORDER step 3+)
# and proposer subprocess calls (step 6+). Subscription auth via the `claude`
# CLI is also supported; see backend/app/meta_harness/proposer.py for the
# precedence rules (mirrors Stanford's claude_wrapper.py).
ANTHROPIC_API_KEY=

# Postgres DSN — must match infra/docker-compose.yml.
POSTGRES_DSN=postgresql://meta_harness:meta_harness@localhost:5432/meta_harness

# Inner-loop model. Defaults to Claude Haiku 4.5 when unset.
# META_HARNESS_INNER_MODEL=

# API bearer token. When set, every backend route except GET /health
# requires `Authorization: Bearer <token>` (SSE also accepts ?token=), and
# `meta-harness serve` refuses to bind a non-loopback host without it.
# The dashboard sends it from NEXT_PUBLIC_META_HARNESS_API_TOKEN
# (see frontend/dashboard/.env.example).
# META_HARNESS_API_TOKEN=

# Optional Weights & Biases tracking (`uv sync --extra wandb`). Off by default.
# META_HARNESS_WANDB=1
# WANDB_MODE=offline
